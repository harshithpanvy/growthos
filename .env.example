# ============================================================================
# GrowthOS — Environment Configuration Template
# Copy this file to `.env.local` and fill in your actual values.
# NEVER commit `.env.local` or expose `SUPABASE_SERVICE_ROLE_KEY` to the client.
# ============================================================================

# 1. Public Supabase Configuration (Safe for browser with Row Level Security enabled)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# 2. Server-Only Supabase Service Role Key (Optional — used ONLY in trusted server API routes
#    for admin analytics/management if bypassing RLS after server-side admin verification.
#    NEVER prefix this with NEXT_PUBLIC_!)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY

# 3. Canonical Site URL (Used for referral links and auth email confirmation redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. Private Supabase Storage Bucket Name for downloadable bonus resources
SUPABASE_RESOURCE_BUCKET=growthos-resources
